---
import FadeIn from './motion/FadeIn.tsx';
const apkUrl = import.meta.env.PUBLIC_APK_URL || '/mainsou.apk';
---
<footer style="font-family:'Plus Jakarta Sans Variable','Plus Jakarta Sans',-apple-system,BlinkMacSystemFont,sans-serif;background:#ffffff;">
  <div class="mx-auto max-w-[1200px] px-6 lg:px-10">

    <!-- ── CTA Banner ── -->
    <FadeIn client:visible>
      <div class="cta-banner">
        <div class="cta-dots"></div>
        <div class="cta-glow"></div>
        <div style="position:relative;z-index:1;text-align:center;">
          <h3 style="font-size:clamp(32px,4vw,52px);font-weight:800;color:#ffffff;letter-spacing:-0.03em;line-height:1.1;margin-bottom:16px;font-family:'Plus Jakarta Sans Variable','Plus Jakarta Sans',sans-serif;">Commencez dès aujourd'hui.</h3>
          <p style="font-size:clamp(16px,1.4vw,20px);font-weight:600;color:rgba(255,255,255,0.82);line-height:1.65;max-width:420px;margin:0 auto 40px;">Patients, téléchargez gratuitement.<br>Pharmaciens, rejoignez le réseau dès maintenant.</p>
          <div style="display:flex;align-items:center;justify-content:center;gap:12px;flex-wrap:wrap;">
            <button onclick="openAuthForDownload()" class="btn-primary btn-large">Télécharger l'application</button>
            <button onclick="openAuth()" class="cta-ghost-btn">Devenir pharmacie partenaire</button>
          </div>
        </div>
      </div>
    </FadeIn>

    <!-- ── Links grid ── -->
    <div style="display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr 1fr;gap:48px;margin-bottom:64px;" class="footer-grid">

      <!-- Brand col -->
      <div>
        <img src="/mainsou.png" alt="Mainsou" style="height:28px;margin-bottom:20px;">
        <p style="font-size:18px;font-weight:600;line-height:1.65;color:#111110;">La pharmacie connectée<br>en Côte d'Ivoire.</p>
      </div>

      <!-- Produit -->
      <div>
        <p style="font-size:12px;font-weight:700;color:#111110;text-transform:uppercase;letter-spacing:0.09em;margin-bottom:20px;">Produit</p>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:14px;">
          <li><a href="#features" class="footer-link">Fonctionnalités</a></li>
          <li><a href="#pricing" class="footer-link">Tarifs</a></li>
          <li><a href="#download" class="footer-link">Télécharger</a></li>
        </ul>
      </div>

      <!-- Entreprise -->
      <div>
        <p style="font-size:12px;font-weight:700;color:#111110;text-transform:uppercase;letter-spacing:0.09em;margin-bottom:20px;">Entreprise</p>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:14px;">
          <li><a href="#" class="footer-link">À propos</a></li>
          <li><a href="mailto:contact@mainsou.app" class="footer-link">Contact</a></li>
        </ul>
      </div>

      <!-- Légal -->
      <div>
        <p style="font-size:12px;font-weight:700;color:#111110;text-transform:uppercase;letter-spacing:0.09em;margin-bottom:20px;">Légal</p>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:14px;">
          <li><a href="/cgu" class="footer-link">CGU</a></li>
          <li><a href="/confidentialite" class="footer-link">Confidentialité</a></li>
        </ul>
      </div>

      <!-- Social -->
      <div>
        <p style="font-size:12px;font-weight:700;color:#111110;text-transform:uppercase;letter-spacing:0.09em;margin-bottom:20px;">Social</p>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:14px;">
          <li>
            <a href="#" class="footer-link" style="display:inline-flex;align-items:center;gap:9px;">
              <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              X / Twitter
            </a>
          </li>
          <li>
            <a href="https://www.linkedin.com/company/mainsou/" target="_blank" rel="noopener noreferrer" class="footer-link" style="display:inline-flex;align-items:center;gap:9px;">
              <svg width="15" height="15" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- ── Bottom bar ── -->
    <div style="border-top:1px solid rgba(0,0,0,0.06);padding:24px 0;display:flex;flex-direction:column;gap:12px;align-items:center;" class="sm:flex-row sm:justify-between">
      <p style="font-size:16px;font-weight:600;color:#111110;">&copy; 2026 Mainsou Technologies. Tous droits réservés.</p>
      <div style="display:flex;align-items:center;gap:6px;font-size:14px;font-weight:600;color:#111110;">
        <span>Conçu avec</span>
        <svg width="13" height="13" fill="#2a7a35" viewBox="0 0 24 24"><path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z"/></svg>
        <span>en Afrique</span>
      </div>
    </div>

  </div>

  <style>
    .footer-link {
      font-size: 18px;
      font-weight: 700;
      color: #111110;
      text-decoration: none;
      transition: color 150ms var(--ease-out);
    }
    @media (hover: hover) and (pointer: fine) {
      .footer-link:hover { color: #111110; }
    }
    .cta-banner {
      padding: 80px 64px;
      margin: 0 0 80px;
      border-radius: 0 0 24px 24px;
      background: linear-gradient(140deg, #0d3315 0%, #092810 50%, #06200e 100%);
      border: 1px solid rgba(255,255,255,0.06);
      box-shadow: 0 8px 40px rgba(0,0,0,0.18);
      position: relative;
      overflow: hidden;
    }
    .cta-dots {
      position: absolute;
      inset: 0;
      background-image: radial-gradient(circle, rgba(255,255,255,0.06) 1px, transparent 1px);
      background-size: 22px 22px;
      mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, black 10%, transparent 100%);
      -webkit-mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, black 10%, transparent 100%);
      pointer-events: none;
    }
    .cta-glow {
      position: absolute;
      top: -40%;
      right: -5%;
      width: 55%;
      height: 180%;
      background: radial-gradient(ellipse, rgba(52,150,64,0.2) 0%, transparent 65%);
      pointer-events: none;
    }
    .cta-ghost-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      font-weight: 600;
      color: rgba(255,255,255,0.82);
      background: transparent;
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 10px;
      padding: 12px 24px;
      cursor: pointer;
      font-family: inherit;
      white-space: nowrap;
      transition: background-color 160ms var(--ease-out), border-color 160ms var(--ease-out), color 160ms var(--ease-out), transform 160ms var(--ease-out);
    }
    .cta-ghost-btn:active { transform: scale(0.97); }
    @media (hover: hover) and (pointer: fine) {
      .cta-ghost-btn:hover { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.35); color: #ffffff; }
    }
    @media (max-width: 640px) {
      .cta-banner { padding: 48px 24px; }
    }
    @media (max-width: 768px) {
      .footer-grid { grid-template-columns: 1fr 1fr !important; gap: 32px !important; }
      .footer-grid > div:first-child { grid-column: 1 / -1; }
    }
    @media (max-width: 480px) {
      .footer-grid { grid-template-columns: 1fr !important; }
    }
    @media (prefers-reduced-motion: reduce) {
      .cta-ghost-btn { transition: background-color 160ms var(--ease-out), border-color 160ms var(--ease-out); }
      .cta-ghost-btn:active { transform: none; }
    }
  </style>
</footer>
