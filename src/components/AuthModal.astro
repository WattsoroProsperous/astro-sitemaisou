---
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_KEY;
const apkUrl = import.meta.env.PUBLIC_APK_URL || '/mainsou.apk';
const locatorPharmaUrl = 'https://pharmaweb-wine.vercel.app';
---
<a id="apk-dl" href={apkUrl} download style="display:none;position:absolute;pointer-events:none;"></a>
<div id="supabaseConfig" data-url={supabaseUrl} data-key={supabaseKey} class="hidden"></div>

<!-- Overlay -->
<div id="authOverlay" class="fixed inset-0 z-[230] bg-black/40 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-200"></div>

<!-- Modal -->
<div id="authModal" class="fixed inset-0 z-[240] flex items-center justify-center p-4 opacity-0 pointer-events-none" style="transition:opacity 200ms var(--ease-out);">
  <div id="authDialog" onclick="event.stopPropagation()" style="background:#ffffff;border-radius:20px;border:1px solid rgba(0,0,0,0.06);box-shadow:0 24px 64px rgba(0,0,0,0.14),0 4px 16px rgba(0,0,0,0.06);width:100%;max-width:440px;max-height:90vh;overflow-y:auto;transform:scale(0.96) translateY(10px);transition:transform 220ms var(--ease-out);">

    <!-- ── STEP 1 : Sélection profil ── -->
    <div id="stepProfile" style="padding:28px 28px 24px;">

      <!-- Header -->
      <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:28px;">
        <div>
          <img src="/mainsou.png" alt="Mainsou" style="height:20px;margin-bottom:14px;filter:brightness(0);">
          <h2 style="font-family:var(--font-heading);font-size:22px;font-weight:800;color:#111110;letter-spacing:-0.03em;line-height:1.15;margin:0;">Choisissez<br>votre espace.</h2>
        </div>
        <button onclick="closeAuth()" style="width:32px;height:32px;border-radius:8px;background:#F3F4F6;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:background-color 150ms var(--ease-out);" onmouseover="this.style.background='#E5E7EB'" onmouseout="this.style.background='#F3F4F6'">
          <svg width="14" height="14" fill="none" stroke="#6B7280" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- Profile cards -->
      <div style="display:flex;flex-direction:column;gap:8px;">

        <!-- Patient -->
        <button onclick="selectProfile()" style="display:flex;align-items:center;gap:16px;padding:16px;border-radius:14px;border:1px solid #E5E7EB;background:#fff;cursor:pointer;text-align:left;width:100%;transition:background-color 150ms var(--ease-out),border-color 150ms var(--ease-out),transform 150ms var(--ease-out);font-family:inherit;" onmouseover="this.style.background='#F9FAFB';this.style.borderColor='rgba(42,122,53,0.4)'" onmouseout="this.style.background='#fff';this.style.borderColor='#E5E7EB'" onmousedown="this.style.transform='scale(0.98)'" onmouseup="this.style.transform='scale(1)'" onmouseleave="this.style.transform='scale(1)'">
          <div style="width:48px;height:48px;border-radius:12px;background:#f0faf1;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <svg width="22" height="22" fill="none" stroke="#2a7a35" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0"/></svg>
          </div>
          <div style="flex:1;min-width:0;">
            <p style="font-size:15px;font-weight:700;color:#111110;margin:0 0 3px;">Patient</p>
            <p style="font-size:13px;color:#111110;margin:0;">Trouvez et réservez vos médicaments</p>
          </div>
          <svg width="16" height="16" fill="none" stroke="#C4C4C0" stroke-width="2.5" viewBox="0 0 24 24" style="flex-shrink:0;"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
        </button>

        <!-- Pharmacien -->
        <a href={locatorPharmaUrl} style="display:flex;align-items:center;gap:16px;padding:16px;border-radius:14px;border:1px solid #E5E7EB;background:#fff;text-decoration:none;transition:background-color 150ms var(--ease-out),border-color 150ms var(--ease-out);" onmouseover="this.style.background='#F9FAFB';this.style.borderColor='rgba(0,137,122,0.4)'" onmouseout="this.style.background='#fff';this.style.borderColor='#E5E7EB'">
          <div style="width:48px;height:48px;border-radius:12px;background:#f0faf9;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <svg width="22" height="22" fill="none" stroke="#00897a" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
          </div>
          <div style="flex:1;min-width:0;">
            <p style="font-size:15px;font-weight:700;color:#111110;margin:0 0 3px;">Pharmacien</p>
            <p style="font-size:13px;color:#111110;margin:0;">Tableau de bord · Réseau Locator</p>
          </div>
          <svg width="16" height="16" fill="none" stroke="#C4C4C0" stroke-width="2.5" viewBox="0 0 24 24" style="flex-shrink:0;"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
        </a>

        <!-- Hôpital -->
        <a href="/doctor/" style="display:flex;align-items:center;gap:16px;padding:16px;border-radius:14px;border:1px solid #E5E7EB;background:#fff;text-decoration:none;transition:background-color 150ms var(--ease-out),border-color 150ms var(--ease-out);" onmouseover="this.style.background='#F9FAFB';this.style.borderColor='rgba(2,119,189,0.4)'" onmouseout="this.style.background='#fff';this.style.borderColor='#E5E7EB'">
          <div style="width:48px;height:48px;border-radius:12px;background:#e8f4fb;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <svg width="22" height="22" fill="none" stroke="#0277bd" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75 3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21"/></svg>
          </div>
          <div style="flex:1;min-width:0;">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:3px;">
              <p style="font-size:15px;font-weight:700;color:#111110;margin:0;">Hôpital / Médecin</p>
              <span style="font-size:9px;font-weight:800;letter-spacing:0.07em;text-transform:uppercase;background:#e8f4fb;color:#0277bd;border:1px solid #b3d9ee;border-radius:4px;padding:2px 6px;line-height:1;">Bientôt</span>
            </div>
            <p style="font-size:13px;color:#111110;margin:0;">Dossiers patients et ordonnances</p>
          </div>
          <svg width="16" height="16" fill="none" stroke="#C4C4C0" stroke-width="2.5" viewBox="0 0 24 24" style="flex-shrink:0;"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
        </a>
      </div>

      <!-- Footer hint -->
      <p style="font-size:12px;color:#111110;text-align:center;margin-top:20px;">Déjà un compte ? Connectez-vous directement dans l'app.</p>
    </div>

    <!-- ── STEP 2 : Inscription patient ── -->
    <div id="stepMobile" class="hidden" style="padding:28px 28px 24px;">

      <!-- Header -->
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">
        <button onclick="goBack()" style="display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:600;color:#111110;background:none;border:none;cursor:pointer;padding:0;font-family:inherit;transition:color 0.15s;" onmouseover="this.style.color='#111110'" onmouseout="this.style.color='#6B7280'">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5"/></svg>
          Retour
        </button>
        <button onclick="closeAuth()" style="width:32px;height:32px;border-radius:8px;background:#F3F4F6;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background-color 150ms var(--ease-out);" onmouseover="this.style.background='#E5E7EB'" onmouseout="this.style.background='#F3F4F6'">
          <svg width="14" height="14" fill="none" stroke="#6B7280" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- Title -->
      <div style="margin-bottom:20px;">
        <h2 style="font-family:var(--font-heading);font-size:20px;font-weight:800;color:#111110;letter-spacing:-0.03em;margin:0 0 4px;">Créer votre compte</h2>
        <p style="font-size:13px;color:#111110;margin:0;">Accédez au réseau pharmaceutique Mainsou Locator.</p>
      </div>

      <!-- Info banner -->
      <div style="display:flex;align-items:flex-start;gap:10px;padding:11px 14px;background:#f0faf1;border:1px solid #c8e6c9;border-radius:10px;margin-bottom:20px;">
        <svg width="14" height="14" fill="none" stroke="#2a7a35" stroke-width="2" viewBox="0 0 24 24" style="flex-shrink:0;margin-top:1px;"><path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z"/></svg>
        <p style="font-size:12px;font-weight:500;color:#2a7a35;line-height:1.55;margin:0;">Trouvez en moins d'une minute quelle pharmacie proche a votre médicament — puis téléchargez l'app pour vous connecter.</p>
      </div>

      <!-- Form -->
      <form id="formMobileSignup" onsubmit="handleMobileSignup(event)" style="display:flex;flex-direction:column;gap:14px;">

        <!-- Nom -->
        <div>
          <label style="display:block;font-size:11px;font-weight:700;color:#111110;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;">Nom complet</label>
          <input type="text" id="mobileSignupName" required
            style="width:100%;padding:0 12px;height:40px;font-size:14px;border:1px solid #E5E7EB;border-radius:10px;background:#F9FAFB;color:#111110;outline:none;transition:border-color 150ms var(--ease-out),background-color 150ms var(--ease-out),box-shadow 150ms var(--ease-out);box-sizing:border-box;font-family:inherit;"
            placeholder="Ex : Kouassi Ama"
            onfocus="this.style.background='#fff';this.style.borderColor='#111110';"
            onblur="this.style.background='#F9FAFB';this.style.borderColor='#E5E7EB';">
        </div>

        <!-- Email -->
        <div>
          <label style="display:block;font-size:11px;font-weight:700;color:#111110;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;">Email</label>
          <input type="email" id="mobileSignupEmail" required
            style="width:100%;padding:0 12px;height:40px;font-size:14px;border:1px solid #E5E7EB;border-radius:10px;background:#F9FAFB;color:#111110;outline:none;transition:border-color 150ms var(--ease-out),background-color 150ms var(--ease-out),box-shadow 150ms var(--ease-out);box-sizing:border-box;font-family:inherit;"
            placeholder="email@domaine.com"
            onfocus="this.style.background='#fff';this.style.borderColor='#111110';"
            onblur="this.style.background='#F9FAFB';this.style.borderColor='#E5E7EB';">
        </div>

        <!-- Mot de passe + Confirmer -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <div>
            <label style="display:block;font-size:11px;font-weight:700;color:#111110;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;">Mot de passe</label>
            <input type="password" id="mobileSignupPassword" required minlength="6"
              style="width:100%;padding:0 12px;height:40px;font-size:14px;border:1px solid #E5E7EB;border-radius:10px;background:#F9FAFB;color:#111110;outline:none;transition:border-color 150ms var(--ease-out),background-color 150ms var(--ease-out),box-shadow 150ms var(--ease-out);box-sizing:border-box;font-family:inherit;"
              placeholder="Min. 6 car."
              onfocus="this.style.background='#fff';this.style.borderColor='#111110';"
              onblur="this.style.background='#F9FAFB';this.style.borderColor='#E5E7EB';">
          </div>
          <div>
            <label style="display:block;font-size:11px;font-weight:700;color:#111110;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:6px;">Confirmer</label>
            <input type="password" id="mobileSignupConfirm" required minlength="6"
              style="width:100%;padding:0 12px;height:40px;font-size:14px;border:1px solid #E5E7EB;border-radius:10px;background:#F9FAFB;color:#111110;outline:none;transition:border-color 150ms var(--ease-out),background-color 150ms var(--ease-out),box-shadow 150ms var(--ease-out);box-sizing:border-box;font-family:inherit;"
              placeholder="••••••"
              onfocus="this.style.background='#fff';this.style.borderColor='#111110';"
              onblur="this.style.background='#F9FAFB';this.style.borderColor='#E5E7EB';">
          </div>
        </div>

        <!-- Error -->
        <div id="mobileSignupError" class="hidden" style="font-size:12px;font-weight:600;color:#DC2626;background:#FEF2F2;border:1px solid #FECACA;border-radius:8px;padding:10px 12px;"></div>

        <!-- Submit -->
        <button type="submit" id="mobileSignupBtn"
          style="width:100%;height:44px;background:#2a7a35;color:#fff;font-size:14px;font-weight:700;border-radius:12px;border:none;cursor:pointer;font-family:var(--font-heading);letter-spacing:-0.01em;transition:background-color 150ms var(--ease-out);margin-top:2px;"
          onmouseover="this.style.background='#349640'" onmouseout="this.style.background='#2a7a35'">
          Créer mon compte
        </button>
      </form>

      <!-- Success state -->
      <div id="mobileSuccess" class="hidden" style="text-align:center;padding:16px 0 8px;">
        <div style="width:56px;height:56px;border-radius:50%;background:#f0faf1;border:1px solid #c8e6c9;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
          <svg width="24" height="24" fill="none" stroke="#2a7a35" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
        </div>
        <p style="font-family:var(--font-heading);font-size:18px;font-weight:800;color:#111110;letter-spacing:-0.02em;margin:0 0 6px;">Compte créé !</p>
        <p style="font-size:13px;color:#111110;line-height:1.6;margin:0 auto 24px;max-width:280px;">Téléchargez l'application Mainsou et connectez-vous avec vos identifiants.</p>
        <a href={apkUrl} download
          style="display:inline-flex;align-items:center;justify-content:center;gap:8px;background:#2a7a35;color:#fff;font-size:14px;font-weight:700;padding:12px 24px;border-radius:12px;text-decoration:none;transition:background-color 150ms var(--ease-out);"
          onmouseover="this.style.background='#349640'" onmouseout="this.style.background='#2a7a35'">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
          Télécharger Mainsou
        </a>
      </div>
    </div>

  </div>
</div>

<script is:inline>
  var _cfg=document.getElementById('supabaseConfig');
  var SUPABASE_URL=_cfg.dataset.url;
  var SUPABASE_KEY=_cfg.dataset.key;
  var sb=null;
  function getSb(){if(!sb)sb=window.supabase.createClient(SUPABASE_URL,SUPABASE_KEY);return sb;}

  function openAuth(){
    var dialog=document.getElementById('authDialog');
    document.getElementById('authOverlay').classList.remove('opacity-0','pointer-events-none');
    document.getElementById('authModal').classList.remove('opacity-0','pointer-events-none');
    if(dialog){ dialog.style.transform='scale(1) translateY(0)'; }
    document.body.style.overflow='hidden';
    goBack();
  }
  function openAuthForDownload(){
    window._pendingApkDownload = true;
    openAuth();
    selectProfile();
  }
  function closeAuth(){
    var dialog=document.getElementById('authDialog');
    if(dialog){ dialog.style.transform='scale(0.96) translateY(10px)'; }
    document.getElementById('authOverlay').classList.add('opacity-0','pointer-events-none');
    document.getElementById('authModal').classList.add('opacity-0','pointer-events-none');
    document.body.style.overflow='';
  }
  document.getElementById('authOverlay').addEventListener('click',closeAuth);

  function goBack(){
    document.getElementById('stepProfile').classList.remove('hidden');
    document.getElementById('stepMobile').classList.add('hidden');
    var f=document.getElementById('formMobileSignup');if(f)f.reset();
    document.getElementById('mobileSignupError').classList.add('hidden');
    document.getElementById('mobileSuccess').classList.add('hidden');
    document.getElementById('formMobileSignup').classList.remove('hidden');
  }

  function selectProfile(){
    document.getElementById('stepProfile').classList.add('hidden');
    document.getElementById('stepMobile').classList.remove('hidden');
  }

  function showError(id,msg){var e=document.getElementById(id);e.textContent=msg;e.classList.remove('hidden');}

  async function handleMobileSignup(e){
    e.preventDefault();
    var pw=document.getElementById('mobileSignupPassword').value;
    var pw2=document.getElementById('mobileSignupConfirm').value;
    if(pw.length<6){showError('mobileSignupError','Le mot de passe doit contenir au moins 6 caractères');return;}
    if(pw!==pw2){showError('mobileSignupError','Les mots de passe ne correspondent pas');return;}
    var btn=document.getElementById('mobileSignupBtn');
    btn.disabled=true;btn.textContent='Chargement...';
    document.getElementById('mobileSignupError').classList.add('hidden');
    var email=document.getElementById('mobileSignupEmail').value.trim();
    try{
      var res=await getSb().auth.signUp({
        email:email,
        password:pw,
        options:{data:{full_name:document.getElementById('mobileSignupName').value.trim()}}
      });
      if(res.error)throw res.error;
      if(res.data&&res.data.user&&res.data.user.identities&&res.data.user.identities.length===0){
        throw {message:'Cet email est déjà utilisé. Veuillez en utiliser un autre ou vous connecter dans l\'app.'};
      }
      if(!res.data||!res.data.session){
        var login=await getSb().auth.signInWithPassword({email:email,password:pw});
        if(login.error)throw {message:'Compte créé mais connexion impossible. Réessayez dans l\'app.'};
      }
      await getSb().auth.signOut();
      document.getElementById('formMobileSignup').classList.add('hidden');
      document.getElementById('mobileSuccess').classList.remove('hidden');
      if(window._pendingApkDownload){
        window._pendingApkDownload=false;
        setTimeout(function(){document.getElementById('apk-dl').click();},400);
      }
    }catch(err){showError('mobileSignupError',err.message||'Erreur lors de l\'inscription');}
    finally{btn.disabled=false;btn.textContent='Créer mon compte';}
  }
</script>
