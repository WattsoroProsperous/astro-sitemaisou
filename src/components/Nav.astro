  <div style="padding:16px;border-top:1px solid #EBEBEB;display:flex;flex-direction:column;gap:10px;">
    <button onclick="openAuth();cl();" style="width:100%;padding:13px 20px;border-radius:12px;border:1px solid #E5E7EB;background:#fff;font-size:15px;font-weight:600;color:#111110;cursor:pointer;font-family:inherit;">Se connecter</button>
    <button onclick="openAuthForDownload();cl();" style="width:100%;padding:13px 20px;border-radius:12px;border:none;background:#2a7a35;font-size:15px;font-weight:700;color:#fff;cursor:pointer;font-family:inherit;display:flex;align-items:center;justify-content:center;gap:8px;">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
      Télécharger
    </button>
  </div>
</div>

<script is:inline>
document.addEventListener('DOMContentLoaded', function () {
  var nav      = document.getElementById('mainNav');
  var panel    = document.getElementById('megaPanel');
  var inner    = document.getElementById('megaInner');
  var dropdown = document.getElementById('navDropdown');
  var btn      = document.getElementById('navDropBtn');
  var chevron  = document.getElementById('navChevron');

  // Scroll
  function updateNav() {
    nav.classList.toggle('scrolled', window.scrollY > 0);
  }
  updateNav();
  window.addEventListener('scroll', updateNav, { passive: true });

  // Mega panel
  var leaveTimer = null;
  var isOpen = false;

  function setPanelTop() {
    if (inner) inner.style.paddingTop = nav.offsetHeight + 'px';
  }

  function openPanel() {
    clearTimeout(leaveTimer);
    if (isOpen) return;
    isOpen = true;
    setPanelTop();
    nav.classList.add('panel-open');
    btn.style.color = '#2a7a35';
    if (chevron) chevron.style.transform = 'rotate(180deg)';
    btn.setAttribute('aria-expanded', 'true');
    panel.style.visibility    = 'visible';
    panel.style.pointerEvents = 'auto';
    panel.style.transition    = 'opacity 0.2s cubic-bezier(0.16,1,0.3,1), transform 0.2s cubic-bezier(0.16,1,0.3,1), visibility 0s';
    panel.offsetHeight; // force reflow
    panel.style.opacity   = '1';
    panel.style.transform = 'translateY(0)';
  }

  function closePanel() {
    if (!isOpen) return;
    isOpen = false;
    nav.classList.remove('panel-open');
    btn.style.color = '';
    if (chevron) chevron.style.transform = '';
    btn.setAttribute('aria-expanded', 'false');
    panel.style.transition = 'opacity 0.18s ease, transform 0.18s ease, visibility 0s linear 0.18s';
    panel.style.opacity    = '0';
    panel.style.transform  = 'translateY(-6px)';
    leaveTimer = setTimeout(function () {
      panel.style.visibility    = 'hidden';
      panel.style.pointerEvents = 'none';
    }, 180);
  }

  if (dropdown && panel) {
    dropdown.addEventListener('mouseenter', openPanel);
    dropdown.addEventListener('mouseleave', function () { leaveTimer = setTimeout(closePanel, 90); });
    panel.addEventListener('mouseenter', function () { clearTimeout(leaveTimer); if (!isOpen) openPanel(); });
    panel.addEventListener('mouseleave', function () { leaveTimer = setTimeout(closePanel, 90); });
    document.addEventListener('click', function (e) {
      if (isOpen && !dropdown.contains(e.target) && !panel.contains(e.target)) closePanel();
    });
    window.addEventListener('resize', function () { if (isOpen) setPanelTop(); });
  }

  // Mega item hover
  document.querySelectorAll('.mega-item').forEach(function (el) {
    el.addEventListener('mouseenter', function () { this.style.background = '#F8FAFC'; });
    el.addEventListener('mouseleave', function () { this.style.background = ''; });
  });

  // Mobile
  var m = document.getElementById('mobileMenu');
  var o = document.getElementById('mobileOverlay');
  function cl() {
    if (m) m.classList.remove('open');
    if (o) o.classList.remove('open');
    document.body.style.overflow = '';
  }
  window.cl = cl;
  var menuBtn   = document.getElementById('menuBtn');
  var closeMenu = document.getElementById('closeMenu');
  if (m && o && menuBtn) {
    menuBtn.addEventListener('click', function () {
      m.classList.add('open'); o.classList.add('open'); document.body.style.overflow = 'hidden';
    });
    if (closeMenu) closeMenu.addEventListener('click', cl);
    o.addEventListener('click', cl);
    m.querySelectorAll('a.mob-link').forEach(function (l) { l.addEventListener('click', cl); });
  }
});
</script>

