---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AuthModal from '../components/AuthModal.astro';
import MainsouPhone from '../components/mockups/MainsouPhone.astro';
import PharmaBrowser from '../components/mockups/PharmaBrowser.astro';
import DoctorBrowser from '../components/mockups/DoctorBrowser.astro';
import FloatingPhone from '../components/motion/FloatingPhone.tsx';
import StepsSection from '../components/motion/StepsSection.tsx';
import FeatureGrid from '../components/motion/FeatureGrid.tsx';
import ChartGains from '../components/motion/ChartGains.tsx';
import FadeIn from '../components/motion/FadeIn.tsx';
import { TextEffect } from '../components/motion/TextEffect.tsx';
import { AnimatedGroup } from '../components/motion/AnimatedGroup.tsx';
const apkUrl = import.meta.env.PUBLIC_APK_URL || '/mainsou.apk';
---
<Layout title="Mainsou — Votre médicament, au prix officiel, dans la pharmacie la plus proche">
<Nav />

<!-- ===== HERO ===== -->
<section class="hero-section">
  <div class="hero-center">
    <div>
      <div class="hero-content-left">
        <h1 class="hero-title text-left" style="margin-bottom:28px;animation:heroFadeUp 0.6s var(--ease-out) 0.05s both;color:rgba(255,255,255,0.93);">
          Le bon médicament,<br>
          au bon endroit,<br>
          au bon moment.
        </h1>
        <p class="text-left" style="font-size:clamp(18px,2.2vw,24px);line-height:1.6;color:rgba(255,255,255,0.7);margin-bottom:48px;max-width:520px;animation:heroFadeUp 0.5s var(--ease-out) 0.15s both;">
          Savoir en 2 minutes quelle pharmacie proche a votre médicament. Sans déplacements inutiles.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-start" style="animation:heroFadeUp 0.5s var(--ease-out) 0.25s both;">
          <button onclick="openAuthForDownload()" class="btn-primary-large group">
            <svg class="w-5 h-5 transition-transform group-hover:translate-y-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
            Je suis patient
          </button>
          <a href="/pharmacien/" class="btn-secondary" style="display:inline-flex;align-items:center;gap:8px;text-decoration:none;">
            Je suis pharmacien
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== MARQUEE ===== -->
<div class="overflow-hidden relative" style="padding:24px 0;background:linear-gradient(90deg, rgba(135,206,250,0.08) 0%, rgba(100,180,255,0.25) 20%, rgba(255,255,255,0.1) 40%, rgba(135,206,250,0.3) 55%, rgba(255,255,255,0.08) 70%, rgba(100,180,255,0.2) 85%, rgba(173,216,230,0.12) 100%);backdrop-filter:blur(40px);-webkit-backdrop-filter:blur(40px);border-top:1px solid rgba(255,255,255,0.4);border-bottom:1px solid rgba(135,206,250,0.25);">
  <div class="marquee-track relative z-10">
    <div class="marquee-content">
      {["Confirmation en 2 minutes", "Géolocalisation", "50 FCFA par recherche aboutie", "Réseau d'officines", "1,24M de patients chroniques", "Prix officiel garanti"].map(text => (
        <>
          <span style="font-size:18px;font-weight:700;color:#191919;letter-spacing:0.08em;text-transform:uppercase;">{text}</span>
          <span style="margin:0 40px;color:rgba(0,0,0,0.2);">&#x2022;</span>
        </>
      ))}
    </div>
    <div class="marquee-content" aria-hidden="true">
      {["Confirmation en 2 minutes", "Géolocalisation", "50 FCFA par recherche aboutie", "Réseau d'officines", "1,24M de patients chroniques", "Prix officiel garanti"].map(text => (
        <>
          <span style="font-size:18px;font-weight:700;color:#191919;letter-spacing:0.08em;text-transform:uppercase;">{text}</span>
          <span style="margin:0 40px;color:rgba(0,0,0,0.2);">&#x2022;</span>
        </>
      ))}
    </div>
  </div>
</div>


<!-- ===== STATS TERRAIN ===== -->
<section style="padding:56px 0;background:#FAFAF8;border-bottom:1px solid rgba(0,0,0,0.05);">
  <div class="mx-auto max-w-[1200px] px-6 lg:px-10">
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:32px;" class="stats-grid">
      <div style="text-align:center;">
        <div style="font-family:var(--font-heading);font-size:clamp(36px,4vw,52px);font-weight:800;letter-spacing:-0.03em;color:#2a7a35;line-height:1;">63</div>
        <div style="font-size:14px;font-weight:700;color:#111110;margin-top:8px;">pharmacies partenaires</div>
        <div style="font-size:12px;color:#6b7280;margin-top:3px;">objectif 6 mois · Treichville & Marcory</div>
      </div>
      <div style="text-align:center;">
        <div style="font-family:var(--font-heading);font-size:clamp(36px,4vw,52px);font-weight:800;letter-spacing:-0.03em;color:#111110;line-height:1;">300F</div>
        <div style="font-size:14px;font-weight:700;color:#111110;margin-top:8px;">de transport perdus</div>
        <div style="font-size:12px;color:#6b7280;margin-top:3px;">en moyenne par achat</div>
      </div>
      <div style="text-align:center;">
        <div style="font-family:var(--font-heading);font-size:clamp(36px,4vw,52px);font-weight:800;letter-spacing:-0.03em;color:#2a7a35;line-height:1;">2 min</div>
        <div style="font-size:14px;font-weight:700;color:#111110;margin-top:8px;">pour confirmer</div>
        <div style="font-size:12px;color:#6b7280;margin-top:3px;">lors du pilote à Treichville</div>
      </div>
      <div style="text-align:center;">
        <div style="font-family:var(--font-heading);font-size:clamp(36px,4vw,52px);font-weight:800;letter-spacing:-0.03em;color:#111110;line-height:1;">1,24M</div>
        <div style="font-size:14px;font-weight:700;color:#111110;margin-top:8px;">patients chroniques</div>
        <div style="font-size:12px;color:#6b7280;margin-top:3px;">à Abidjan (HTA, diabète…)</div>
      </div>
    </div>
    <p style="text-align:center;font-size:11px;color:#9ca3af;margin-top:24px;letter-spacing:0.02em;">Enquête terrain · 50 patients interrogés à la sortie du CHU de Treichville · Pilote : 10 pharmacies, 24 patients</p>
  </div>
</section>
<style>
  @media (max-width: 640px) { .stats-grid { grid-template-columns: 1fr 1fr !important; row-gap: 36px; } }
</style>

<!-- ===== HOW IT WORKS ===== -->
<section id="how" style="padding:140px 0;">
  <div class="mx-auto max-w-[1200px] px-6 lg:px-10">
    <FadeIn client:visible>
      <div style="margin-bottom:56px;">
        <div class="section-label" style="color:#e67a2e;">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>
          Comment ça marche
        </div>
        <TextEffect client:visible as="h2" className="heading-section" per="word" preset="blur">Trois étapes. Zéro friction.</TextEffect>
        <p class="body-large" style="margin-top:16px;max-width:640px;">50 patients interrogés à la sortie du CHU de Treichville : en moyenne, ils visitent trois pharmacies avant de trouver leur médicament, et dépensent plus de 300 francs de transport. Le médicament est souvent disponible — le patient ne sait simplement pas où le trouver.</p>
      </div>
    </FadeIn>
    <StepsSection client:visible />
  </div>
</section>

<!-- ===== VIDEO PRÉSENTATION ===== -->
<section id="video-section" style="padding:0;background:#0a0a0a;position:relative;">
  <video id="presVideo" loop playsinline muted style="width:100%;display:block;">
    <source src="/video_pres.mp4" type="video/mp4" />
  </video>
  <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);display:flex;flex-direction:column;align-items:center;gap:12px;z-index:10;">
    <button id="videoPlayBtn" style="width:80px;height:80px;border-radius:50%;background:rgba(255,255,255,0.15);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:2px solid rgba(255,255,255,0.3);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background-color 160ms var(--ease-out),transform 160ms var(--ease-out),border-color 160ms var(--ease-out);">
      <svg style="width:32px;height:32px;margin-left:4px;" fill="#ffffff" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
    </button>
    <span style="color:rgba(255,255,255,0.75);font-size:12px;font-weight:600;letter-spacing:0.02em;white-space:nowrap;">Inscrivez-vous pour regarder</span>
  </div>
</section>

<!-- ===== CE QUE NOUS PROPOSONS — dark block ===== -->
<section id="apps" style="padding:140px 0;background:linear-gradient(160deg,#e8ecef 0%,#dfe4e8 30%,#d5dce2 60%,#e0e5ea 100%);--txt-heading:#111110;--txt-body:#111110;">
  <div class="mx-auto max-w-[1200px] px-6 lg:px-10 relative z-10">
    <FadeIn client:visible>
      <div style="margin-bottom:64px;">
        <div class="section-label" style="color:#349640;">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 16.875h3.375m0 0h3.375m-3.375 0V13.5m0 3.375v3.375M6 10.5h2.25a2.25 2.25 0 0 0 2.25-2.25V6a2.25 2.25 0 0 0-2.25-2.25H6A2.25 2.25 0 0 0 3.75 6v2.25A2.25 2.25 0 0 0 6 10.5Zm0 9.75h2.25A2.25 2.25 0 0 0 10.5 18v-2.25a2.25 2.25 0 0 0-2.25-2.25H6a2.25 2.25 0 0 0-2.25 2.25V18A2.25 2.25 0 0 0 6 20.25Zm9.75-9.75H18a2.25 2.25 0 0 0 2.25-2.25V6A2.25 2.25 0 0 0 18 3.75h-2.25A2.25 2.25 0 0 0 13.5 6v2.25a2.25 2.25 0 0 0 2.25 2.25Z"/></svg>
          Ce que nous proposons
        </div>
        <TextEffect client:visible as="h2" className="heading-section" per="word" preset="blur">Disponible aujourd'hui.</TextEffect>
        <p class="body-large" style="margin-top:16px;max-width:580px;">Trois services complémentaires : patient, pharmacie, hôpital.</p>
      </div>
    </FadeIn>

    <!-- Apps bento grid -->
    <div class="apps-bento">

      <!-- Patient — full width -->
      <div style="grid-column:1/-1;">
        <FadeIn client:visible>
          <div class="app-card">
            <div class="app-card-split">
              <div class="app-card-text-col">
                <p style="font-size:11px;font-weight:600;color:#9CA3AF;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:20px;">Pour les patients</p>
                <h3 style="font-family:var(--font-heading);font-size:clamp(28px,3vw,44px);font-weight:800;letter-spacing:-0.03em;color:#111110;line-height:1.1;margin-bottom:16px;">Trouvez.<br>En 2 minutes.</h3>
                <p style="font-size:clamp(15px,1.4vw,17px);color:#111110;line-height:1.7;margin-bottom:32px;max-width:380px;hyphens:none;">Cherchez votre médicament. Les pharmacies partenaires reçoivent votre demande et confirment la disponibilité, le prix et le délai. Vous partez avec certitude.</p>
                <div style="display:flex;flex-direction:column;gap:12px;">
                  {['Confirmation par le pharmacien (10–30 min)', 'Prix officiel garanti avant de partir', '50 FCFA par recherche aboutie'].map(item => (
                    <div style="display:flex;align-items:center;gap:10px;">
                      <svg style="width:14px;height:14px;flex-shrink:0;" fill="none" stroke="#2a7a35" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
                      <span style="font-size:14px;font-weight:500;color:#111110;">{item}</span>
                    </div>
                  ))}
                </div>
              </div>
              <div class="app-card-video-panel">
                <video autoplay muted playsinline
                  style="width:160px;border-radius:20px;box-shadow:0 24px 60px rgba(0,0,0,0.18),0 4px 12px rgba(0,0,0,0.08);display:block;"
                  ontimeupdate="if(this.currentTime>=5){this.currentTime=0;}">
                  <source src="/mainsou.mp4" type="video/mp4" />
                </video>
              </div>
            </div>
          </div>
        </FadeIn>
      </div>

      <!-- Pharmacien -->
      <FadeIn client:visible delay={0.05}>
        <div class="app-card" style="height:100%;">
          <div class="app-card-media">
            <img src="/espace-pharmacien.png" alt="Espace Pharmacien"
              style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top center;display:block;" />
          </div>
          <div class="app-card-content">
            <p style="font-size:11px;font-weight:600;color:#9CA3AF;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:14px;">Pour les pharmaciens</p>
            <h3 style="font-family:var(--font-heading);font-size:clamp(20px,2vw,26px);font-weight:800;letter-spacing:-0.03em;color:#111110;line-height:1.15;margin-bottom:12px;">De nouveaux patients.<br>Des données de demande.</h3>
            <p style="font-size:clamp(14px,1.3vw,15px);color:#111110;line-height:1.7;margin-bottom:20px;hyphens:none;">Recevez les demandes de patients dans votre zone. Mainsou vous donne aussi la carte des médicaments les plus recherchés, même quand vous ne les avez pas en stock.</p>
            <div style="display:flex;flex-direction:column;gap:9px;">
              {['Demandes patients en temps réel', "Données de demande locale (même sans stock)", "Réseau d'entraide entre officines"].map(item => (
                <div style="display:flex;align-items:center;gap:9px;">
                  <svg style="width:13px;height:13px;flex-shrink:0;" fill="none" stroke="#9CA3AF" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
                  <span style="font-size:13px;font-weight:500;color:#111110;">{item}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </FadeIn>

      <!-- Hôpital — Bientôt -->
      <FadeIn client:visible delay={0.1}>
        <div class="app-card" style="height:100%;opacity:0.88;">
          <div class="app-card-media">
            <img src="/espace-hopital.png" alt="Espace Hôpital"
              style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top center;display:block;filter:grayscale(0.15);opacity:0.9;" />
            <span style="position:absolute;top:14px;right:14px;padding:4px 11px;border-radius:40px;font-size:10px;font-weight:700;letter-spacing:0.07em;text-transform:uppercase;background:rgba(255,255,255,0.94);color:#111110;box-shadow:0 1px 4px rgba(0,0,0,0.1);">Bientôt</span>
          </div>
          <div class="app-card-content">
            <p style="font-size:11px;font-weight:600;color:#9CA3AF;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:14px;">Hôpitaux &amp; médecins</p>
            <h3 style="font-family:var(--font-heading);font-size:clamp(20px,2vw,26px);font-weight:800;letter-spacing:-0.03em;color:#111110;line-height:1.15;margin-bottom:12px;">Pour les hôpitaux<br>et médecins.</h3>
            <p style="font-size:clamp(14px,1.3vw,15px);color:#111110;line-height:1.7;margin-bottom:20px;hyphens:none;">Dossier Médical Partagé, ordonnances numériques à code unique et gestion multi-établissements. Déployé progressivement avec les autorités de santé.</p>
            <div style="display:flex;flex-direction:column;gap:9px;margin-bottom:24px;">
              {['Dossier Médical Partagé inter-établissements', 'Ordonnances numériques à code unique', 'Gestion des médecins par établissement'].map(item => (
                <div style="display:flex;align-items:center;gap:9px;">
                  <svg style="width:13px;height:13px;flex-shrink:0;" fill="none" stroke="#9CA3AF" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
                  <span style="font-size:13px;font-weight:500;color:#111110;">{item}</span>
                </div>
              ))}
            </div>
            <a href="/hopital/" style="display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:600;color:#6B7280;background:#F7F7F5;border:1px solid rgba(0,0,0,0.08);border-radius:8px;padding:8px 16px;text-decoration:none;transition:background-color 150ms var(--ease-out);" onmouseover="this.style.backgroundColor='#eeeeec'" onmouseout="this.style.backgroundColor='#F7F7F5'">
              <svg style="width:12px;height:12px;" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0"/></svg>
              Être informé du lancement
            </a>
          </div>
        </div>
      </FadeIn>

    </div>

    <!-- Charts contextuels : patient (vert) + pharmacie (teal) -->
    <div style="margin-top:32px;display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:stretch;" class="charts-row">
      <ChartGains variant="patient" client:visible />
      <ChartGains variant="pharma"  client:visible />
    </div>

  </div>
</section>

<!-- ===== POUR LES OFFICINES — warm light ===== -->
<section id="features" class="s-warm" style="padding:140px 0;">
  <div class="mx-auto max-w-[1200px] px-6 lg:px-10 relative z-10">
    <FadeIn client:visible>
      <div style="margin-bottom:56px;">
        <div class="section-label" style="color:#00bfa6;">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z"/></svg>
          Pour les officines
        </div>
        <TextEffect client:visible as="h2" className="heading-section" per="word" preset="blur">Ce qui change pour votre pharmacie.</TextEffect>
        <p class="body-large" style="margin-top:16px;max-width:540px;">Déjà opérationnel dans 7 officines du Grand Abidjan depuis fin 2025.</p>
      </div>
    </FadeIn>
    <FeatureGrid client:visible />
  </div>
</section>

<style>
  @media (max-width: 640px) { .charts-row { grid-template-columns: 1fr !important; } }
</style>

<!-- ===== PRICING ===== -->
<section id="pricing" style="padding:140px 0;background:linear-gradient(160deg, #e8ecef 0%, #dfe4e8 30%, #d5dce2 60%, #e0e5ea 100%);">
  <div class="mx-auto max-w-[1200px] px-6 lg:px-10">

    <FadeIn client:visible>
      <div style="text-align:center;margin-bottom:72px;">
        <div class="section-label" style="color:#e67a2e;justify-content:center;">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z"/></svg>
          Tarifs
        </div>
        <TextEffect client:visible as="h2" className="heading-section" per="word" preset="blur">Simple. Transparent.</TextEffect>
        <p class="body-large" style="margin-top:16px;max-width:560px;margin-left:auto;margin-right:auto;">Mainsou ne touche ni au prix ni à la marge du médicament. Vous ne payez que ce qui vous apporte de la valeur.</p>
      </div>
    </FadeIn>

    <FadeIn client:visible delay={0.08}>
      <div class="pricing-grid">

        <!-- ── Patient ── -->
        <div class="pricing-card">
          <div style="margin-bottom:32px;">
            <p style="font-size:11px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#6b7280;margin-bottom:20px;">Patient</p>
            <p style="font-family:var(--font-heading);font-size:52px;font-weight:800;letter-spacing:-0.04em;color:#111110;line-height:1;">50 <span style="font-size:22px;font-weight:700;letter-spacing:-0.01em;">FCFA</span></p>
            <p style="font-size:14px;font-weight:600;color:#111110;margin-top:8px;">par recherche aboutie</p>
            <p style="font-size:12px;color:#6b7280;margin-top:4px;">Gratuit si aucune pharmacie ne confirme</p>
          </div>
