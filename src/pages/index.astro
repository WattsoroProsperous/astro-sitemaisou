---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AuthModal from '../components/AuthModal.astro';
import MainsouPhone from '../components/mockups/MainsouPhone.astro';
import PharmaBrowser from '../components/mockups/PharmaBrowser.astro';
import DoctorBrowser from '../components/mockups/DoctorBrowser.astro';
const apkUrl = import.meta.env.PUBLIC_APK_URL || '/mainsou.apk';
---
<Layout title="Mainsou — De l'ordonnance à votre porte">
<Nav />

<!-- ===== HERO ===== -->
<section class="hero-section pt-20 pb-12 sm:pt-24 sm:pb-16 md:pt-28 md:pb-20">
  <div class="relative z-10 mx-auto max-w-[1120px] px-6">
    <div class="flex flex-col md:flex-row gap-16 md:gap-12 items-center">
      <div class="flex-1 text-center md:text-left">
        <h1 class="text-[clamp(32px,6vw,56px)] font-bold leading-[1.06] tracking-[-0.03em] text-white mb-5">Vos médicaments,<br>livrés chez vous.</h1>
        <p class="text-[16px] leading-[1.7] text-white/60 mb-8 max-w-[420px] mx-auto md:mx-0 tracking-[-0.01em]">De l'ordonnance à la livraison. Un écosystème complet qui connecte patients, médecins et pharmacies.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center md:justify-start">
          <a href={apkUrl} download class="inline-flex items-center justify-center gap-2 bg-white text-[#0A0A0A] font-semibold text-[14px] rounded-lg px-6 py-3 hover:bg-white/90 transition-colors tracking-[-0.01em]">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
            Télécharger l'APK
          </a>
          <button onclick="openAuth()" class="inline-flex items-center justify-center gap-2 text-white/70 hover:text-white font-medium text-[14px] rounded-lg px-6 py-3 border border-white/10 hover:border-white/20 transition-all tracking-[-0.01em]">S'inscrire</button>
        </div>
      </div>
      <div class="flex-shrink-0">
        <MainsouPhone />
      </div>
    </div>
  </div>
</section>

<!-- ===== MARQUEE TRUST BAR ===== -->
<div class="border-b border-[#e5e5e5] bg-white py-4 overflow-hidden">
  <div class="marquee-track">
    <div class="marquee-content">
      <span class="text-[13px] font-bold text-[#0A0A0A] tracking-wide uppercase">Ordonnances numériques</span>
      <span class="text-[13px] text-[#e5e5e5] mx-6">/</span>
      <span class="text-[13px] font-bold text-[#0A0A0A] tracking-wide uppercase">OCR intelligent</span>
      <span class="text-[13px] text-[#e5e5e5] mx-6">/</span>
      <span class="text-[13px] font-bold text-[#0A0A0A] tracking-wide uppercase">Géolocalisation</span>
      <span class="text-[13px] text-[#e5e5e5] mx-6">/</span>
      <span class="text-[13px] font-bold text-[#0A0A0A] tracking-wide uppercase">Livraison GPS</span>
      <span class="text-[13px] text-[#e5e5e5] mx-6">/</span>
      <span class="text-[13px] font-bold text-[#0A0A0A] tracking-wide uppercase">Chiffrement E2E</span>
      <span class="text-[13px] text-[#e5e5e5] mx-6">/</span>
    </div>
    <div class="marquee-content" aria-hidden="true">
      <span class="text-[13px] font-bold text-[#0A0A0A] tracking-wide uppercase">Ordonnances numériques</span>
      <span class="text-[13px] text-[#e5e5e5] mx-6">/</span>
      <span class="text-[13px] font-bold text-[#0A0A0A] tracking-wide uppercase">OCR intelligent</span>
      <span class="text-[13px] text-[#e5e5e5] mx-6">/</span>
      <span class="text-[13px] font-bold text-[#0A0A0A] tracking-wide uppercase">Géolocalisation</span>
      <span class="text-[13px] text-[#e5e5e5] mx-6">/</span>
      <span class="text-[13px] font-bold text-[#0A0A0A] tracking-wide uppercase">Livraison GPS</span>
      <span class="text-[13px] text-[#e5e5e5] mx-6">/</span>
      <span class="text-[13px] font-bold text-[#0A0A0A] tracking-wide uppercase">Chiffrement E2E</span>
      <span class="text-[13px] text-[#e5e5e5] mx-6">/</span>
    </div>
  </div>
</div>

<!-- ===== HOW ===== -->
<section id="how" class="py-24 md:py-32 bg-white">
  <div class="mx-auto max-w-[1120px] px-6">
    <div class="mb-16 reveal">
      <p class="text-[11px] font-semibold text-brand tracking-[0.1em] uppercase mb-3">Comment ça marche</p>
      <h2 class="text-[32px] sm:text-[40px] font-bold leading-[1.08] tracking-[-0.03em]">Quatre étapes. Zéro friction.</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-0 reveal">
      <!-- Step 1 -->
      <div class="relative p-6 border border-[#e5e5e5] sm:border-r-0 lg:border-r-0 rounded-tl-lg rounded-bl-lg sm:rounded-bl-none lg:rounded-bl-lg">
        <span class="text-[11px] font-semibold text-[#9CA3AF] tracking-[0.08em]">01</span>
        <h3 class="text-[16px] font-semibold tracking-[-0.02em] mt-3 mb-2">Consultation</h3>
        <p class="text-[13px] font-semibold text-[#6B7280] leading-relaxed">Votre médecin crée une ordonnance numérique et vous remet un code unique.</p>
      </div>
      <!-- Step 2 -->
      <div class="relative p-6 border border-[#e5e5e5] sm:border-r sm:border-l-0 lg:border-r-0">
        <span class="text-[11px] font-semibold text-[#9CA3AF] tracking-[0.08em]">02</span>
        <h3 class="text-[16px] font-semibold tracking-[-0.02em] mt-3 mb-2">Recherche</h3>
        <p class="text-[13px] font-semibold text-[#6B7280] leading-relaxed">Le moteur trouve les pharmacies proches avec vos médicaments en stock.</p>
      </div>
      <!-- Step 3 -->
      <div class="relative p-6 border border-[#e5e5e5] sm:border-t-0 lg:border-t sm:border-r-0 lg:border-r-0 lg:border-l-0">
        <span class="text-[11px] font-semibold text-[#9CA3AF] tracking-[0.08em]">03</span>
        <h3 class="text-[16px] font-semibold tracking-[-0.02em] mt-3 mb-2">Préparation</h3>
        <p class="text-[13px] font-semibold text-[#6B7280] leading-relaxed">La pharmacie valide et prépare votre commande en quelques minutes.</p>
      </div>
      <!-- Step 4 -->
      <div class="relative p-6 border border-[#e5e5e5] sm:border-t-0 lg:border-t sm:border-l-0 lg:border-l-0 rounded-tr-none lg:rounded-tr-lg rounded-br-lg sm:rounded-br-none lg:rounded-br-lg">
        <span class="text-[11px] font-semibold text-brand tracking-[0.08em]">04</span>
        <h3 class="text-[16px] font-semibold tracking-[-0.02em] mt-3 mb-2">Livraison</h3>
        <p class="text-[13px] font-semibold text-[#6B7280] leading-relaxed">Un livreur vérifié vous livre avec suivi GPS en temps réel.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===== APPS ===== -->
<section id="apps" class="py-24 md:py-32 bg-[#FAFAFA] border-t border-[#e5e5e5]">
  <div class="mx-auto max-w-[1120px] px-6">
    <div class="mb-20 reveal">
      <p class="text-[11px] font-semibold text-brand tracking-[0.1em] uppercase mb-3">L'écosystème</p>
      <h2 class="text-[32px] sm:text-[40px] font-bold leading-[1.08] tracking-[-0.03em]">Trois apps. Un système.</h2>
    </div>

    <!-- APP 1: Mainsou -->
    <div class="flex flex-col md:flex-row gap-12 items-center mb-28 reveal">
      <div class="flex-1 order-2 md:order-1">
        <div class="inline-flex items-center gap-2 mb-5">
          <div class="w-6 h-6 rounded-md bg-brand flex items-center justify-center">
            <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0"/></svg>
          </div>
          <span class="text-[13px] font-semibold text-brand tracking-[-0.01em]">Mainsou</span>
        </div>
        <h3 class="text-[24px] sm:text-[28px] font-bold tracking-[-0.03em] mb-3 leading-tight">Pour les patients & livreurs</h3>
        <p class="text-[14px] font-semibold text-[#6B7280] leading-[1.7] mb-6 max-w-md">Carte interactive des pharmacies proches, commande par code ordonnance ou photo OCR, suivi GPS du livreur en temps réel.</p>
        <div class="space-y-3">
          <div class="flex items-center gap-3 text-[13px] text-[#0A0A0A]">
            <div class="w-5 h-5 rounded-md bg-forest-50 flex items-center justify-center flex-shrink-0"><svg class="w-3 h-3 text-brand" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg></div>
            OCR intelligent des ordonnances
          </div>
          <div class="flex items-center gap-3 text-[13px] text-[#0A0A0A]">
            <div class="w-5 h-5 rounded-md bg-forest-50 flex items-center justify-center flex-shrink-0"><svg class="w-3 h-3 text-brand" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg></div>
            Pharmacies géolocalisées sur carte
          </div>
          <div class="flex items-center gap-3 text-[13px] text-[#0A0A0A]">
            <div class="w-5 h-5 rounded-md bg-forest-50 flex items-center justify-center flex-shrink-0"><svg class="w-3 h-3 text-brand" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg></div>
            Suivi GPS du livreur en direct
          </div>
        </div>
      </div>
      <div class="order-1 md:order-2 flex justify-center"><MainsouPhone /></div>
    </div>

    <!-- Separator -->
    <div class="grid-line mb-28"></div>

    <!-- APP 2: Pharma -->
    <div class="flex flex-col md:flex-row gap-12 items-center mb-28 reveal">
      <div class="flex justify-center flex-shrink-0 w-full md:w-auto"><PharmaBrowser /></div>
      <div class="flex-1">
        <div class="inline-flex items-center gap-2 mb-5">
          <div class="w-6 h-6 rounded-md bg-[#0A8754] flex items-center justify-center">
            <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
          </div>
          <span class="text-[13px] font-semibold text-[#0A8754] tracking-[-0.01em]">Pharma App</span>
        </div>
        <h3 class="text-[24px] sm:text-[28px] font-bold tracking-[-0.03em] mb-3 leading-tight">Pour les pharmaciens</h3>
        <p class="text-[14px] font-semibold text-[#6B7280] leading-[1.7] mb-6 max-w-md">Dashboard complet : ventes, commandes, clients actifs, graphiques, produits les plus vendus. Gestion de stock et ROI intégrés.</p>
        <div class="space-y-3">
          <div class="flex items-center gap-3 text-[13px] text-[#0A0A0A]">
            <div class="w-5 h-5 rounded-md bg-green-50 flex items-center justify-center flex-shrink-0"><svg class="w-3 h-3 text-[#0A8754]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg></div>
            KPIs ventes, commandes, clients
          </div>
          <div class="flex items-center gap-3 text-[13px] text-[#0A0A0A]">
            <div class="w-5 h-5 rounded-md bg-green-50 flex items-center justify-center flex-shrink-0"><svg class="w-3 h-3 text-[#0A8754]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg></div>
            Graphiques ventes + catégories
          </div>
          <div class="flex items-center gap-3 text-[13px] text-[#0A0A0A]">
            <div class="w-5 h-5 rounded-md bg-green-50 flex items-center justify-center flex-shrink-0"><svg class="w-3 h-3 text-[#0A8754]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg></div>
            Dashboard ROI & crédits
          </div>
        </div>
      </div>
    </div>

    <!-- Separator -->
    <div class="grid-line mb-28"></div>

    <!-- APP 3: Doctor -->
    <div class="flex flex-col md:flex-row gap-12 items-center reveal">
      <div class="flex-1 order-2 md:order-1">
        <div class="inline-flex items-center gap-2 mb-5">
          <div class="w-6 h-6 rounded-md bg-[#0E7C86] flex items-center justify-center">
            <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 0 1-.659 1.591L5 14.5"/></svg>
          </div>
          <span class="text-[13px] font-semibold text-[#0E7C86] tracking-[-0.01em]">Doctor App</span>
        </div>
        <h3 class="text-[24px] sm:text-[28px] font-bold tracking-[-0.03em] mb-3 leading-tight">Pour les hôpitaux & médecins</h3>
        <p class="text-[14px] font-semibold text-[#6B7280] leading-[1.7] mb-6 max-w-md">Dossier patient partagé entre hôpitaux, ordonnances numériques avec code, gestion des médecins par établissement.</p>
        <div class="space-y-3">
          <div class="flex items-center gap-3 text-[13px] text-[#0A0A0A]">
            <div class="w-5 h-5 rounded-md bg-teal-50 flex items-center justify-center flex-shrink-0"><svg class="w-3 h-3 text-[#0E7C86]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg></div>
            Dossier patient unique et partagé
          </div>
          <div class="flex items-center gap-3 text-[13px] text-[#0A0A0A]">
            <div class="w-5 h-5 rounded-md bg-teal-50 flex items-center justify-center flex-shrink-0"><svg class="w-3 h-3 text-[#0E7C86]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg></div>
            E-ordonnances avec code patient
          </div>
          <div class="flex items-center gap-3 text-[13px] text-[#0A0A0A]">
            <div class="w-5 h-5 rounded-md bg-teal-50 flex items-center justify-center flex-shrink-0"><svg class="w-3 h-3 text-[#0E7C86]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg></div>
            Gestion médecins par hôpital
          </div>
        </div>
      </div>
      <div class="order-1 md:order-2 flex justify-center w-full md:w-auto"><DoctorBrowser /></div>
    </div>
  </div>
</section>

<!-- ===== FEATURES ===== -->
<section id="features" class="py-24 md:py-32 bg-white border-t border-[#e5e5e5]">
  <div class="mx-auto max-w-[1120px] px-6">
    <div class="mb-16 reveal">
      <p class="text-[11px] font-semibold text-brand tracking-[0.1em] uppercase mb-3">Fonctionnalités</p>
      <h2 class="text-[32px] sm:text-[40px] font-bold leading-[1.08] tracking-[-0.03em]">Pensé pour chaque détail.</h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-[#e5e5e5] border border-[#e5e5e5] rounded-lg overflow-hidden reveal">
      <!-- Feature 1 -->
      <div class="bg-white p-7">
        <div class="w-8 h-8 rounded-md bg-forest-50 flex items-center justify-center mb-4">
          <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-5.232 0 2.192 2.192 0 0 0-1.736 1.039l-.821 1.316Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0Z"/></svg>
        </div>
        <p class="text-[15px] font-semibold tracking-[-0.02em] mb-1.5">OCR intelligent</p>
        <p class="text-[13px] font-semibold text-[#6B7280] leading-relaxed">Photographiez votre ordonnance. Médicaments, dosages et quantités détectés automatiquement.</p>
      </div>
      <!-- Feature 2 -->
      <div class="bg-white p-7">
        <div class="w-8 h-8 rounded-md bg-forest-50 flex items-center justify-center mb-4">
          <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>
        </div>
        <p class="text-[15px] font-semibold tracking-[-0.02em] mb-1.5">Géolocalisation</p>
        <p class="text-[13px] font-semibold text-[#6B7280] leading-relaxed">Trouve les pharmacies proches avec vos médicaments en stock, triées par distance.</p>
      </div>
      <!-- Feature 3 -->
      <div class="bg-white p-7">
        <div class="w-8 h-8 rounded-md bg-forest-50 flex items-center justify-center mb-4">
          <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"/></svg>
        </div>
        <p class="text-[15px] font-semibold tracking-[-0.02em] mb-1.5">Scission intelligente</p>
        <p class="text-[13px] font-semibold text-[#6B7280] leading-relaxed">Médicament manquant ? Le système optimise automatiquement entre pharmacies.</p>
      </div>
      <!-- Feature 4 -->
      <div class="bg-white p-7">
        <div class="w-8 h-8 rounded-md bg-forest-50 flex items-center justify-center mb-4">
          <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08"/></svg>
        </div>
        <p class="text-[15px] font-semibold tracking-[-0.02em] mb-1.5">Dossier médical partagé</p>
        <p class="text-[13px] font-semibold text-[#6B7280] leading-relaxed">Un dossier unique accessible par tous les hôpitaux agréés du réseau.</p>
      </div>
      <!-- Feature 5 -->
      <div class="bg-white p-7">
        <div class="w-8 h-8 rounded-md bg-forest-50 flex items-center justify-center mb-4">
          <svg class="w-4 h-4 text-brand" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0"/></svg>
        </div>
        <p class="text-[15px] font-semibold tracking-[-0.02em] mb-1.5">Suivi temps réel</p>
        <p class="text-[13px] font-semibold text-[#6B7280] leading-relaxed">Notification à chaque étape. Position GPS du livreur en direct sur la carte.</p>
      </div>
      <!-- Feature 6 -->
      <div class="bg-white p-7">
        <div class="w-8 h-8 rounded-md bg-[#FEF3C7] flex items-center justify-center mb-4">
          <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"/></svg>
        </div>
        <p class="text-[15px] font-semibold tracking-[-0.02em] mb-1.5">Sécurité santé</p>
        <p class="text-[13px] font-semibold text-[#6B7280] leading-relaxed">Chiffrement bout-en-bout, audit trail complet, conformité données de santé.</p>
      </div>
    </div>
  </div>
</section>

<!-- ===== SCREENS ===== -->
<section class="py-24 md:py-32 bg-[#FAFAFA] border-t border-[#e5e5e5]">
  <div class="mx-auto max-w-[1120px] px-6">
    <div class="mb-16 reveal">
      <p class="text-[11px] font-semibold text-brand tracking-[0.1em] uppercase mb-3">En images</p>
