    box-shadow: 0 4px 28px rgba(42,122,53,0.1), 0 2px 16px rgba(100,115,135,0.1);
    transform: translateY(-8px);
  }
  @media (max-width: 768px) {
    .pricing-grid { grid-template-columns: 1fr; max-width: 480px; }
    .pricing-card-featured { transform: none; }
  }

  /* Apps bento grid */
  .apps-bento {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .app-card {
    background: rgba(255, 255, 255, 0.36);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.58);
    box-shadow: 0 2px 16px rgba(100, 115, 135, 0.1), 0 1px 3px rgba(0,0,0,0.04);
    display: flex;
    flex-direction: column;
    transition: transform 280ms var(--ease-out), box-shadow 280ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .app-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(100, 120, 148, 0.18), 0 2px 8px rgba(0,0,0,0.05);
    }
  }
  /* Patient card: horizontal split */
  .app-card-split {
    display: grid;
    grid-template-columns: 1fr 300px;
    align-items: stretch;
    flex: 1;
  }
  .app-card-text-col {
    padding: 56px 48px 56px 56px;
  }
  .app-card-video-panel {
    background: rgba(210, 218, 226, 0.38);
    border-left: 1px solid rgba(255, 255, 255, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 40px;
  }
  /* Bottom cards: media + content */
  .app-card-media {
    flex: 1;
    min-height: 280px;
    background: rgba(190, 202, 214, 0.42);
    overflow: hidden;
    position: relative;
  }
  .app-card-content {
    padding: 32px 40px 40px;
    flex-shrink: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.45);
  }
  /* ── 900px: patient card stacks ── */
  @media (max-width: 900px) {
    .app-card-split {
      grid-template-columns: 1fr;
    }
    .app-card-text-col {
      padding: 40px 36px;
    }
    .app-card-video-panel {
      border-left: none;
      border-top: 1px solid rgba(0,0,0,0.06);
      min-height: 220px;
      padding: 36px;
    }
  }
  /* ── 768px: bento passe en 1 colonne ── */
  @media (max-width: 768px) {
    .apps-bento {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .app-card-media { min-height: 240px; }
  }
  /* ── 480px: padding réduit au maximum ── */
  @media (max-width: 480px) {
    #apps { padding: 72px 0 !important; }
    .app-card-text-col { padding: 28px 20px; }
    .app-card-video-panel { padding: 28px 20px; min-height: 200px; }
    .app-card-content { padding: 24px 20px 28px; }
    .app-card-media { min-height: 200px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .app-card { transition: none; }
  }
</style>

