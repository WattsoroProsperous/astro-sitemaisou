<script is:inline>
  var m=document.getElementById('mobileMenu'),o=document.getElementById('mobileOverlay');
  document.getElementById('menuBtn').addEventListener('click',function(){m.classList.add('open');o.classList.add('open');document.body.style.overflow='hidden'});
  function cl(){m.classList.remove('open');o.classList.remove('open');document.body.style.overflow=''}
  document.getElementById('closeMenu').addEventListener('click',cl);o.addEventListener('click',cl);
  document.querySelectorAll('#mobileMenu a').forEach(function(l){l.addEventListener('click',cl)});
  var navLinks=document.querySelectorAll('.nav-link');
  var sections=document.querySelectorAll('section[id]');
  var isClicking=false;
  var clickTimer=null;
  function setActive(id){navLinks.forEach(function(l){l.classList.remove('active');if(l.getAttribute('href')==='#'+id)l.classList.add('active')})}
  document.querySelectorAll('a[href^="#"]').forEach(function(a){a.addEventListener('click',function(e){var t=document.querySelector(this.getAttribute('href'));if(t){e.preventDefault();isClicking=true;clearTimeout(clickTimer);navLinks.forEach(function(l){l.classList.remove('active')});if(this.classList.contains('nav-link'))this.classList.add('active');window.scrollTo({top:t.offsetTop-60,behavior:'smooth'});clickTimer=setTimeout(function(){isClicking=false},800)}})});
  var observer=new IntersectionObserver(function(entries){if(isClicking)return;entries.forEach(function(entry){if(entry.isIntersecting){setActive(entry.target.getAttribute('id'))}})},{rootMargin:'-20% 0px -60% 0px',threshold:0});
  sections.forEach(function(sec){observer.observe(sec)});

  // FAQ split panel
  var faqBtns=document.querySelectorAll('.faq-btn');
  var faqAnswers=document.querySelectorAll('.faq-answer');
  faqBtns.forEach(function(btn){
    btn.addEventListener('click',function(){
      var idx=this.getAttribute('data-faq');
      faqBtns.forEach(function(b){b.classList.remove('faq-btn-active')});
      faqAnswers.forEach(function(a){a.classList.remove('faq-answer-active')});
      this.classList.add('faq-btn-active');
      var target=document.querySelector('.faq-answer[data-answer="'+idx+'"]');
      if(target) target.classList.add('faq-answer-active');
    });
  });

  // Video player
  var video = document.getElementById('presVideo');
  var playBtn = document.getElementById('videoPlayBtn');
  var playIcon = document.getElementById('playIcon');
  var pauseIcon = document.getElementById('pauseIcon');
  var userPlaying = false;

  playBtn.addEventListener('click', function() {
    if (video.paused) {
      video.muted = false;
      video.play();
      userPlaying = true;
      playIcon.style.display = 'none';
      pauseIcon.style.display = 'block';
      playBtn.style.opacity = '0';
    } else {
      video.pause();
      userPlaying = false;
      playIcon.style.display = 'block';
      pauseIcon.style.display = 'none';
      playBtn.style.opacity = '1';
    }
  });

  var videoSection = document.getElementById('video-section');
  var videoObserver = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (!entry.isIntersecting && userPlaying) {
        video.pause();
        userPlaying = false;
        playIcon.style.display = 'block';
        pauseIcon.style.display = 'none';
        playBtn.style.opacity = '1';
      }
    });
  }, { threshold: 0.3 });
  videoObserver.observe(videoSection);

  videoSection.addEventListener('mouseenter', function() {
    if (!video.paused) playBtn.style.opacity = '0.7';
  });
  videoSection.addEventListener('mouseleave', function() {
    if (!video.paused) playBtn.style.opacity = '0';
  });
</script>
</Layout>
