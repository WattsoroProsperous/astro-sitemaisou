<style>
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 980px;
    margin: 0 auto;
    align-items: stretch;
  }
  .pricing-card {
    background: rgba(255, 255, 255, 0.36);
