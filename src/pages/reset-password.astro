---
import Layout from '../layouts/Layout.astro';
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_KEY;
---
<Layout title="Réinitialiser le mot de passe — Mainsou">
<div id="supabaseConfig" data-url={supabaseUrl} data-key={supabaseKey} class="hidden"></div>

<div class="min-h-screen flex items-center justify-center px-4 py-20">
  <div class="w-full max-w-[400px]">
    <div class="text-center mb-8">
      <a href="/"><img src="/mainsou.png" alt="Mainsou" class="h-8 mx-auto mb-4"></a>
    </div>

    <div id="stateLoading" class="text-center py-12">
      <div class="w-8 h-8 border-2 border-[#e5e5e5] border-t-[#0A0A0A] rounded-full animate-spin mx-auto mb-4"></div>
      <p class="text-[14px] font-semibold text-[#6B7280]">Vérification en cours...</p>
    </div>

    <div id="stateError" class="hidden">
      <div class="bg-white border border-[#e5e5e5] rounded-lg p-6 text-center">
        <div class="w-12 h-12 rounded-full bg-[#FEF2F2] flex items-center justify-center mx-auto mb-4"><svg class="w-6 h-6 text-[#EF4444]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg></div>
        <p class="text-[16px] font-bold mb-2">Lien invalide ou expiré</p>
        <p class="text-[13px] font-semibold text-[#6B7280] mb-6">Ce lien de réinitialisation n'est plus valide. Veuillez en demander un nouveau.</p>
        <a href="/" class="inline-flex items-center justify-center text-[13px] font-bold text-[#0A0A0A] border border-[#e5e5e5] rounded-lg px-5 py-2.5 hover:border-[#0A0A0A] transition-colors">Retour à l'accueil</a>
      </div>
    </div>

    <div id="stateForm" class="hidden">
      <div class="bg-white border border-[#e5e5e5] rounded-lg p-6">
        <h1 class="text-[18px] font-bold tracking-[-0.02em] mb-1">Nouveau mot de passe</h1>
        <p class="text-[13px] font-semibold text-[#6B7280] mb-6">Saisissez votre nouveau mot de passe ci-dessous.</p>
        <form id="resetForm" onsubmit="handleReset(event)" class="space-y-4">
          <div><label class="block text-[12px] font-bold text-[#6B7280] mb-1.5">Nouveau mot de passe</label><input type="password" id="newPassword" required minlength="6" class="w-full px-3 py-2.5 text-[14px] border border-[#e5e5e5] rounded-lg bg-[#FAFAFA] focus:border-[#0A0A0A] focus:outline-none transition-colors" placeholder="Min. 6 caractères"></div>
          <div><label class="block text-[12px] font-bold text-[#6B7280] mb-1.5">Confirmer le mot de passe</label><input type="password" id="confirmPassword" required minlength="6" class="w-full px-3 py-2.5 text-[14px] border border-[#e5e5e5] rounded-lg bg-[#FAFAFA] focus:border-[#0A0A0A] focus:outline-none transition-colors" placeholder="••••••••"></div>
          <div id="resetError" class="text-[12px] font-semibold text-[#EF4444] hidden"></div>
          <button type="submit" id="resetBtn" class="w-full bg-[#0A0A0A] text-white text-[13px] font-bold rounded-lg py-3 hover:bg-[#1a1a1a] transition-colors">Réinitialiser le mot de passe</button>
        </form>
      </div>
    </div>

    <div id="stateSuccess" class="hidden">
      <div class="bg-white border border-[#e5e5e5] rounded-lg p-6 text-center">
        <div class="w-12 h-12 rounded-full bg-[#f3f6f2] flex items-center justify-center mx-auto mb-4"><svg class="w-6 h-6 text-[#3B5B32]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg></div>
        <p class="text-[16px] font-bold mb-2">Mot de passe modifié !</p>
        <p class="text-[13px] font-semibold text-[#6B7280] mb-6">Vous pouvez maintenant vous connecter avec votre nouveau mot de passe.</p>
        <a href="/" id="successLink" class="inline-flex items-center justify-center gap-2 text-[13px] font-bold bg-[#0A0A0A] text-white rounded-lg px-5 py-2.5 hover:bg-[#1a1a1a] transition-colors">Se connecter</a>
      </div>
    </div>
  </div>
</div>

<style>
  @keyframes spin { to { transform: rotate(360deg); } }
  .animate-spin { animation: spin 0.8s linear infinite; }
</style>

<script is:inline>
  var _cfg=document.getElementById('supabaseConfig');
  var SUPABASE_URL=_cfg.dataset.url;
  var SUPABASE_KEY=_cfg.dataset.key;
  var sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
  var isRecoverySession = false;

  function show(id) {
    ['stateLoading','stateError','stateForm','stateSuccess'].forEach(function(s){
      document.getElementById(s).classList.add('hidden');
    });
    document.getElementById(id).classList.remove('hidden');
  }

  async function init() {
    try {
      var hash = window.location.hash.substring(1);
      var params = new URLSearchParams(hash);
      var accessToken = params.get('access_token');
      var refreshToken = params.get('refresh_token');
      var type = params.get('type');

      // Seul un token de type recovery est accepté — pas de session existante
      if (type === 'recovery' && accessToken && refreshToken) {
        var { error } = await sb.auth.setSession({
          access_token: accessToken,
          refresh_token: refreshToken
        });
        if (error) throw error;
        isRecoverySession = true;
        history.replaceState(null, '', window.location.pathname);
        show('stateForm');
      } else {
        show('stateError');
      }
    } catch (err) {
      console.error('Init error:', err);
      show('stateError');
    }
  }

  async function handleReset(e) {
    e.preventDefault();
    if (!isRecoverySession) { show('stateError'); return; }

    var pw = document.getElementById('newPassword').value;
    var pw2 = document.getElementById('confirmPassword').value;
    var errorEl = document.getElementById('resetError');

    if (pw.length < 6) { errorEl.textContent='Le mot de passe doit contenir au moins 6 caractères'; errorEl.classList.remove('hidden'); return; }
    if (pw !== pw2) { errorEl.textContent='Les mots de passe ne correspondent pas'; errorEl.classList.remove('hidden'); return; }

    var btn = document.getElementById('resetBtn');
    btn.disabled = true; btn.textContent = 'Chargement...';
    errorEl.classList.add('hidden');

    try {
      var { data, error } = await sb.auth.updateUser({ password: pw });
      if (error) throw error;

      // Redirection selon le rôle
      var role = data.user?.user_metadata?.role || '';
      var link = document.getElementById('successLink');
      if (role === 'pharmacien') { link.href='/pharma/'; link.textContent='Ouvrir Pharma App'; }
      else if (role === 'hospital_admin' || role === 'doctor') { link.href='/doctor/'; link.textContent='Ouvrir Doctor App'; }

      await sb.auth.signOut();
      isRecoverySession = false;
      show('stateSuccess');
    } catch (err) {
      errorEl.textContent = err.message || 'Erreur lors de la réinitialisation';
      errorEl.classList.remove('hidden');
      btn.disabled = false; btn.textContent = 'Réinitialiser le mot de passe';
    }
  }

  init();
</script>
</Layout>
