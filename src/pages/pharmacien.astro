---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AuthModal from '../components/AuthModal.astro';
import FadeIn from '../components/motion/FadeIn.tsx';
---
<Layout title="Mainsou Réseau — Pour les pharmaciens">
<Nav />

<!-- ===== HERO ===== -->
<section style="padding:160px 0 100px;background:#0a0a0a;">
  <div class="mx-auto max-w-[900px] px-6 lg:px-10 text-center">
    <div style="display:inline-flex;align-items:center;gap:8px;padding:6px 14px;border-radius:20px;background:rgba(0,191,166,0.12);border:1px solid rgba(0,191,166,0.25);margin-bottom:28px;">
      <span style="width:6px;height:6px;border-radius:50%;background:#00bfa6;display:inline-block;"></span>
      <span style="font-size:13px;font-weight:600;color:#00bfa6;letter-spacing:0.04em;">DISPONIBLE AUJOURD'HUI</span>
    </div>
    <h1 style="font-size:clamp(36px,6vw,68px);font-weight:800;color:#ffffff;letter-spacing:-0.025em;line-height:1.1;margin-bottom:24px;">
      Des commandes payées.<br>Moins de stock dormant.
    </h1>
    <p style="font-size:clamp(17px,1.8vw,20px);line-height:1.65;color:rgba(255,255,255,0.6);margin-bottom:44px;max-width:560px;margin-left:auto;margin-right:auto;">
      Mainsou Réseau connecte votre officine aux patients de votre zone et aux pharmacies voisines. Vos commandes arrivent déjà payées.
    </p>
    <button onclick="openAuth()" style="display:inline-flex;align-items:center;gap:10px;background:#00bfa6;color:#fff;font-size:16px;font-weight:700;padding:14px 32px;border-radius:12px;border:none;cursor:pointer;transition:all 0.15s;" onmouseover="this.style.background='#00a88f'" onmouseout="this.style.background='#00bfa6'">
      Devenir partenaire
    </button>
  </div>
</section>

<!-- ===== LE PROBLÈME ===== -->
<section style="padding:100px 0;background:#F7F7F5;">
  <div class="mx-auto max-w-[1100px] px-6 lg:px-10">
    <FadeIn client:visible>
      <div style="max-width:760px;margin:0 auto;text-align:center;">
        <div style="display:inline-flex;align-items:center;gap:8px;padding:5px 14px;border-radius:20px;background:rgba(230,122,46,0.1);border:1px solid rgba(230,122,46,0.2);margin-bottom:24px;">
          <span style="font-size:12px;font-weight:700;color:#e67a2e;letter-spacing:0.05em;text-transform:uppercase;">Le problème</span>
        </div>
        <h2 style="font-size:clamp(28px,4vw,44px);font-weight:700;color:#1C1F26;letter-spacing:-0.02em;line-height:1.2;margin-bottom:20px;">Deux pharmacies à 3 km l'une de l'autre.</h2>
        <p style="font-size:clamp(17px,1.8vw,20px);line-height:1.7;color:#111110;">L'une a du stock dormant, l'autre est en rupture sur le même produit. Le patient parcourt la ville pour trouver son médicament, ou se tourne vers le marché informel. Tout le monde perd : le patient, la pharmacie en rupture, et celle qui a le stock sans personne à qui le vendre.</p>
      </div>
    </FadeIn>
  </div>
</section>

<!-- ===== CE QUE MAINSOU APPORTE ===== -->
<section style="padding:100px 0;background:#fff;">
  <div class="mx-auto max-w-[1100px] px-6 lg:px-10">
    <FadeIn client:visible>
      <div style="margin-bottom:52px;text-align:center;">
        <h2 style="font-size:clamp(28px,4vw,44px);font-weight:700;color:#1C1F26;letter-spacing:-0.02em;line-height:1.2;margin-bottom:16px;">Ce que Mainsou apporte à votre officine</h2>
        <p style="font-size:17px;color:#111110;max-width:480px;margin:0 auto;">Trois apports concrets, disponibles dès votre adhésion.</p>
      </div>
    </FadeIn>
    <FadeIn client:visible delay={0.06}>
      <div class="grid md:grid-cols-3 gap-5">
        <div class="notion-card p-8">
          <div style="width:44px;height:44px;border-radius:12px;background:rgba(0,191,166,0.1);color:#00bfa6;display:flex;align-items:center;justify-content:center;margin-bottom:20px;">
            <svg style="width:22px;height:22px;" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75"/></svg>
          </div>
          <h3 style="font-size:18px;font-weight:700;color:#1C1F26;margin-bottom:10px;">Commandes déjà payées</h3>
          <p style="font-size:15px;color:#111110;line-height:1.65;">Les patients réservent et paient par Mobile Money avant de venir. Vous recevez une commande confirmée, pas une promesse de passage.</p>
        </div>
        <div class="notion-card p-8">
          <div style="width:44px;height:44px;border-radius:12px;background:rgba(155,93,229,0.1);color:#9b5de5;display:flex;align-items:center;justify-content:center;margin-bottom:20px;">
            <svg style="width:22px;height:22px;" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5"/></svg>
          </div>
          <h3 style="font-size:18px;font-weight:700;color:#1C1F26;margin-bottom:10px;">Dépannage entre officines</h3>
          <p style="font-size:15px;color:#111110;line-height:1.65;">Mainsou met en relation les officines du même quartier. Votre stock dormant trouve preneur. En rupture, vous pouvez orienter le patient vers une officine voisine.</p>
        </div>
        <div class="notion-card p-8">
          <div style="width:44px;height:44px;border-radius:12px;background:rgba(230,122,46,0.1);color:#e67a2e;display:flex;align-items:center;justify-content:center;margin-bottom:20px;">
            <svg style="width:22px;height:22px;" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"/></svg>
          </div>
          <h3 style="font-size:18px;font-weight:700;color:#1C1F26;margin-bottom:10px;">Aide à la commande</h3>
          <p style="font-size:15px;color:#111110;line-height:1.65;">Savoir quoi commander et en quelle quantité selon la demande réelle de votre zone. Moins de surstock, moins de ruptures sur les produits courants.</p>
        </div>
      </div>
    </FadeIn>
  </div>
</section>

<!-- ===== OFFRES ===== -->
<section style="padding:100px 0;background:linear-gradient(160deg, #e8ecef 0%, #dfe4e8 30%, #d5dce2 60%, #e0e5ea 100%);">
  <div class="mx-auto max-w-[900px] px-6 lg:px-10">
    <FadeIn client:visible>
      <div style="margin-bottom:48px;text-align:center;">
        <h2 style="font-size:clamp(28px,4vw,40px);font-weight:700;color:#1C1F26;letter-spacing:-0.02em;margin-bottom:16px;">Deux niveaux d'engagement</h2>
        <p style="font-size:17px;color:#111110;">Mainsou ne touche ni au prix ni à la marge du médicament.</p>
      </div>
    </FadeIn>
    <FadeIn client:visible delay={0.06}>
      <div class="grid md:grid-cols-2 gap-5">
        <div class="notion-card relative" style="padding:36px;box-shadow:0 0 0 2px rgba(42,122,53,0.15), 0 4px 16px rgba(0,0,0,0.06);">
          <div style="position:absolute;top:-1px;left:24px;right:24px;height:3px;background:linear-gradient(90deg,#2a7a35,#349640);border-radius:2px;"></div>
          <p style="font-size:12px;font-weight:700;color:#2a7a35;letter-spacing:0.07em;text-transform:uppercase;margin-bottom:16px;">Mainsou Réseau</p>
          <p style="font-size:36px;font-weight:800;letter-spacing:-0.03em;color:#1C1F26;margin-bottom:4px;">30 000 FCFA</p>
          <p style="font-size:14px;font-weight:600;color:#111110;margin-bottom:28px;">par mois</p>
          <ul style="display:flex;flex-direction:column;gap:12px;margin-bottom:32px;">
            {['Commandes déjà payées', 'Mise en relation avec les officines voisines', 'Aide à la commande selon votre zone', 'Connexion stock par API ou validation manuelle'].map(item => (
              <li style="display:flex;align-items:flex-start;gap:10px;font-size:14px;font-weight:600;color:#1C1F26;">
                <svg style="width:16px;height:16px;color:#2a7a35;flex-shrink:0;margin-top:1px;" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
                {item}
              </li>
            ))}
          </ul>
          <button onclick="openAuth()" style="display:block;width:100%;text-align:center;font-size:15px;font-weight:700;color:#fff;background:#2a7a35;border-radius:10px;padding:13px 16px;border:none;cursor:pointer;transition:all 0.15s;" onmouseover="this.style.background='#349640'" onmouseout="this.style.background='#2a7a35'">Devenir partenaire</button>
        </div>
        <div class="notion-card" style="padding:36px;">
          <p style="font-size:12px;font-weight:700;color:#111110;letter-spacing:0.07em;text-transform:uppercase;margin-bottom:16px;">Option Officine</p>
          <p style="font-size:36px;font-weight:800;letter-spacing:-0.03em;color:#1C1F26;margin-bottom:4px;">+35 000 FCFA</p>
          <p style="font-size:14px;font-weight:600;color:#111110;margin-bottom:4px;">par mois, en plus du Réseau</p>
          <p style="font-size:12px;color:#9CA3AF;margin-bottom:28px;">Frais d'intégration en sus</p>
          <ul style="display:flex;flex-direction:column;gap:12px;margin-bottom:32px;">
            {["Tout Mainsou Réseau inclus", "Logiciel de gestion d'officine complet", "Inventaire automatique par RFID", "Tableau de bord ventes et stock"].map(item => (
              <li style="display:flex;align-items:flex-start;gap:10px;font-size:14px;font-weight:600;color:#1C1F26;">
                <svg style="width:16px;height:16px;color:#2a7a35;flex-shrink:0;margin-top:1px;" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
                {item}
              </li>
            ))}
          </ul>
          <button onclick="openAuth()" style="display:block;width:100%;text-align:center;font-size:15px;font-weight:600;color:#1C1F26;background:#f5f5f3;border-radius:10px;padding:13px 16px;border:none;cursor:pointer;transition:all 0.15s;" onmouseover="this.style.background='#ebebea'" onmouseout="this.style.background='#f5f5f3'">En savoir plus</button>
        </div>
      </div>
    </FadeIn>
    <FadeIn client:visible delay={0.1}>
      <p style="text-align:center;font-size:14px;color:#9CA3AF;margin-top:24px;">Marketplace parapharmacie : 10 % sur les ventes apportées par Mainsou. Rien sur le médicament.</p>
    </FadeIn>
  </div>
</section>

<!-- ===== PREUVE ===== -->
<section style="padding:80px 0;background:#fff;border-bottom:1px solid rgba(0,0,0,0.06);">
  <div class="mx-auto max-w-[900px] px-6 lg:px-10">
    <FadeIn client:visible>
      <div style="text-align:center;">
        <p style="font-size:clamp(56px,10vw,96px);font-weight:900;color:#2a7a35;letter-spacing:-0.04em;line-height:1;margin-bottom:12px;">7</p>
        <p style="font-size:18px;font-weight:600;color:#1C1F26;margin-bottom:8px;">officines équipées dans le Grand Abidjan</p>
        <p style="font-size:15px;color:#111110;">depuis fin 2025</p>
      </div>
    </FadeIn>
  </div>
</section>

<!-- ===== CTA ===== -->
<section style="padding:100px 0;background:#0a0a0a;">
  <div class="mx-auto max-w-[700px] px-6 lg:px-10 text-center">
    <FadeIn client:visible>
      <h2 style="font-size:clamp(28px,4vw,44px);font-weight:800;color:#fff;letter-spacing:-0.025em;margin-bottom:20px;">Rejoignez Mainsou Réseau</h2>
      <p style="font-size:17px;color:rgba(255,255,255,0.6);line-height:1.65;margin-bottom:36px;max-width:480px;margin-left:auto;margin-right:auto;">Vous avez des questions sur l'intégration ? Contactez-nous ou créez votre compte directement.</p>
      <div style="display:flex;flex-direction:row;gap:12px;justify-content:center;flex-wrap:wrap;">
        <button onclick="openAuth()" style="display:inline-flex;align-items:center;gap:10px;background:#2a7a35;color:#fff;font-size:15px;font-weight:700;padding:13px 28px;border-radius:12px;border:none;cursor:pointer;transition:all 0.15s;" onmouseover="this.style.background='#349640'" onmouseout="this.style.background='#2a7a35'">Devenir partenaire</button>
        <a href="mailto:contact@mainsou.app" style="display:inline-flex;align-items:center;gap:10px;background:rgba(255,255,255,0.08);color:rgba(255,255,255,0.8);font-size:15px;font-weight:600;padding:13px 28px;border-radius:12px;border:1px solid rgba(255,255,255,0.15);cursor:pointer;transition:all 0.15s;text-decoration:none;" onmouseover="this.style.background='rgba(255,255,255,0.12)'" onmouseout="this.style.background='rgba(255,255,255,0.08)'">Nous contacter</a>
      </div>
    </FadeIn>
  </div>
</section>

<Footer />
<AuthModal />

<script is:inline>
  var m=document.getElementById('mobileMenu'),o=document.getElementById('mobileOverlay');
  if(m && o && document.getElementById('menuBtn')) {
    document.getElementById('menuBtn').addEventListener('click',function(){m.classList.add('open');o.classList.add('open');document.body.style.overflow='hidden'});
    function cl(){m.classList.remove('open');o.classList.remove('open');document.body.style.overflow=''}
    document.getElementById('closeMenu').addEventListener('click',cl);
    o.addEventListener('click',cl);
    document.querySelectorAll('#mobileMenu a').forEach(function(l){l.addEventListener('click',cl)});
  }
</script>
</Layout>
