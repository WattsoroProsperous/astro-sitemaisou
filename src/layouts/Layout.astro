---
import '../styles/global.css';
interface Props { title: string; }
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content="Mainsou digitalise le parcours de soin en Afrique. De l'ordonnance à la livraison de médicaments à domicile.">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,600,700,800,900&f[]=switzer@400,500,600&display=swap" rel="stylesheet">
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
</head>
<body class="bg-surface text-[#111110]">
  <slot />
</body>
</html>
